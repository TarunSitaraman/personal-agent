# Copy to desktop/.env and fill in, or export these before launching.
# Electron does not read .env automatically here — see desktop/README.md for how to pass them.

# Production API base, no trailing slash.
API_BASE=https://personal-agent-blond-beta.vercel.app

# Must match DASHBOARD_TOKEN in the server environment.
API_TOKEN=

# Optional. Defaults to desktop/frames. Only needed if the sprite frames live elsewhere.
PET_FRAMES_DIR=
