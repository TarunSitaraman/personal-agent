{
  "cli": { "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_BASE": "https://personal-agent-blond-beta.vercel.app" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_BASE": "https://personal-agent-blond-beta.vercel.app" }
    }
  }
}
