# Copy to mobile/.env and fill in. mobile/.env is gitignored — never commit real values.
# Expo inlines EXPO_PUBLIC_* into the bundle at build time, so restart the dev server after edits.

# Production API base, no trailing slash.
EXPO_PUBLIC_API_BASE=https://personal-agent-blond-beta.vercel.app

# Must match DASHBOARD_TOKEN in the server environment (Vercel → Settings → Environment Variables).
EXPO_PUBLIC_API_TOKEN=
